{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "geek-by-carlos",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/admin/*", "/api/*", "/ebay-notifications/*"]
  },
  "kv_namespaces": [
    {
      "binding": "PEDIDOS_KV",
      "id": "b8171d9dd2a74d7a92bf125b88fccf9b"
    },
    {
      "binding": "SESSION",
      "id": "61a78ccb64a1491a942149e780daf412"
    }
  ],
  "d1_databases": [
    {
      "binding": "CATALOGO_DB",
      "database_name": "geek-catalogo",
      "database_id": "f93f7295-168a-434c-a1ae-7aa4bf3305e1",
      "migrations_dir": "migrations"
    }
  ],
  "images": {
    "binding": "IMAGES"
  }
}
