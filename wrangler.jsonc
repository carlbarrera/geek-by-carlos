      "binding": "PEDIDOS_KV",
      "id": "b8171d9dd2a74d7a92bf125b88fccf9b"
    },
    {
      "binding": "SESSION",
      "id": "61a78ccb64a1491a942149e780daf412"
    }
  ],
  "images": {
    "binding": "IMAGES"
  }
}
