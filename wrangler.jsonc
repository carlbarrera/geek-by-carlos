{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "geek-by-carlos",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist",
  "kv_namespaces": [
